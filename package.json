{
  "name": "@cloudcannon/editable-regions",
  "version": "0.0.0",
  "type": "module",
  "description": "Visual Editing for the CloudCannon CMS.",
  "keywords": [
    "cloudcannon"
  ],
  "license": "MIT",
  "author": "CloudCannon <support@cloudcannon.com>",
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://github.com/CloudCannon/editable-regions#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudCannon/editable-regions.git"
  },
  "bugs": {
    "url": "https://github.com/CloudCannon/editable-regions/issues",
    "email": "support@cloudcannon.com"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch -p tsconfig.json",
    "typecheck:watch:test": "tsc --noEmit --watch -p test/tsconfig.json",
    "lint-autofix": "biome check --fix",
    "lint": "biome check",
    "build:hugo": "bash integrations/hugo/renderer/build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "vitest run -u",
    "test:build-fixtures": "npm run build && npm run test:build-astro-fixture && npm run test:build-eleventy-fixture && npm run test:build-eleventy-plugin-config && npm run test:build-hugo-fixture && npm run test:build-hugo-custom-dirs && npm run test:build-hugo-config-options && npm run test:build-hugo-templates-overrides",
    "test:build-hugo-custom-dirs": "npm --prefix test/unit/_fixtures/hugo-custom-dirs run build",
    "test:build-hugo-config-options": "npm --prefix test/unit/_fixtures/hugo-config-options run build",
    "test:build-hugo-templates-overrides": "npm --prefix test/unit/_fixtures/hugo-templates-overrides run build",
    "test:build-hugo-fixtures": "npm run test:build-hugo-fixture && npm run test:build-hugo-custom-dirs && npm run test:build-hugo-config-options && npm run test:build-hugo-templates-overrides",
    "test:build-astro-fixture": "npm --prefix test/unit/_fixtures/astro install --silent && npm --prefix test/unit/_fixtures/astro run build",
    "test:build-eleventy-fixture": "npm --prefix test/unit/_fixtures/eleventy install --silent && npm --prefix test/unit/_fixtures/eleventy run build",
    "test:build-eleventy-plugin-config": "npm --prefix test/unit/_fixtures/eleventy-plugin-config install --silent && npm --prefix test/unit/_fixtures/eleventy-plugin-config run build",
    "test:build-hugo-fixture": "npm --prefix test/unit/_fixtures/hugo run build",
    "test:integration": "npm run build:hugo && bash run-integration-tests.sh"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": null,
    "./astro": {
      "types": "./dist/integrations/astro/index.d.ts",
      "default": "./dist/integrations/astro/index.js"
    },
    "./astro-react-renderer": {
      "types": "./dist/integrations/astro/react-renderer.d.ts",
      "default": "./dist/integrations/astro/react-renderer.js"
    },
    "./astro-svelte-renderer": {
      "types": "./dist/integrations/astro/svelte-renderer.d.ts",
      "default": "./dist/integrations/astro/svelte-renderer.js"
    },
    "./astro-vue-renderer": {
      "types": "./dist/integrations/astro/vue-renderer.d.ts",
      "default": "./dist/integrations/astro/vue-renderer.js"
    },
    "./astro-integration": {
      "types": "./dist/integrations/astro/astro-integration.d.ts",
      "default": "./dist/integrations/astro/astro-integration.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "default": "./dist/integrations/react.js"
    },
    "./svelte": {
      "types": "./dist/integrations/svelte/index.d.ts",
      "svelte": "./dist/integrations/svelte/index.js",
      "default": "./dist/integrations/svelte/index.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue.d.ts",
      "default": "./dist/integrations/vue.js"
    },
    "./liquid": {
      "types": "./dist/integrations/liquid/index.d.ts",
      "default": "./dist/integrations/liquid/index.js"
    },
    "./eleventy": {
      "require": {
        "types": "./dist/integrations/eleventy/index.d.cts",
        "default": "./dist/integrations/eleventy/index.cjs"
      },
      "import": {
        "types": "./dist/integrations/eleventy/index.d.ts",
        "default": "./dist/integrations/eleventy/index.js"
      }
    },
    "./eleventy/browser": {
      "types": "./dist/integrations/eleventy/browser/index.d.ts",
      "default": "./dist/integrations/eleventy/browser/index.js"
    },
    "./internal/components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./internal/styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    }
  },
  "devDependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/svelte": "9.1.2",
    "@astrojs/vue": "7.1.2",
    "@biomejs/biome": "2.6.4",
    "@sindresorhus/slugify": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/js-beautify": "1.14.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "astro": "7.4.4",
    "happy-dom": "21.0.4",
    "js-beautify": "2.0.3",
    "liquidjs": "10.30.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "slugify": "1.6.9",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@cloudcannon/configuration-types": "0.0.67",
    "@cloudcannon/visual-editor-api": "0.0.22",
    "esbuild": "0.28.2"
  }
}
