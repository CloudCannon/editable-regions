{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"components/**",
			"helpers/**",
			"integrations/**",
			"components/**",
			"nodes/**",
			"styles/**",
			"test/**",
			"types/**",
			"!test/integrations",
			"!test/unit/_fixtures/hugo",
			"!test/unit/_fixtures/hugo-config-options",
			"!test/unit/_fixtures/hugo-custom-dirs",
			"!test/unit/_fixtures/hugo-templates-overrides",
			"!**/*.astro",
			"!**/*.svelte",
			"!**/*.vue",
			"!**/*.d.mts",
			"!integrations/hugo/renderer",
			"!integrations/hugo/browser/wasm_exec.js",
			"!integrations/hugo/browser/entry.js",
			"!integrations/hugo/hugo-module"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noParameterAssign": "off",
				"noInferrableTypes": "off"
			},
			"complexity": {
				"useArrowFunction": "off",
				"noForEach": "off",
				"noImportantStyles": "off"
			},
			"correctness": {
				"noVoidTypeReturn": "off",
				"useHookAtTopLevel": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noShadowRestrictedNames": "off",
				"noImplicitAnyLet": "warn",
				"useIterableCallbackReturn": "off"
			},
			"performance": {
				"noDelete": "off",
				"noAccumulatingSpread": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
